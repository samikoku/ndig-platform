{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npx vite build && node scripts/doctrine-check.mjs && node scripts/build-api.mjs",
  "outputDirectory": "public",
  "env": {
    "VITE_API_BASE": "http://localhost:3000",
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/weekly", "schedule": "0 9 * * *" },
    { "path": "/api/cron/daily-insight", "schedule": "0 8 * * *" }
  ],
  "redirects": [
    { "source": "/investment-nexus", "destination": "/", "statusCode": 301 },
    { "source": "/diaspora-bonds", "destination": "/", "statusCode": 301 },
    { "source": "/banking-options", "destination": "/", "statusCode": 301 },
    { "source": "/investment-index", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
